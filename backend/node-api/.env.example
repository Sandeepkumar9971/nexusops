PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ai-hub?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
PYTHON_AI_BASE_URL=http://127.0.0.1:8000
JWT_SECRET=<a long random string — generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`>

# Shared secret the Python AI service presents when it calls back into
# Node (currently only to create a notification after a job finishes).
# Generate the same way as JWT_SECRET; must match python-ai's
# INTERNAL_API_TOKEN exactly. If unset, that internal route refuses every
# request (fails closed) rather than accepting unauthenticated calls.
INTERNAL_API_TOKEN=<a long random string, same value as python-ai's INTERNAL_API_TOKEN>

# Optional. A job stuck in PENDING/QUEUED/PROCESSING longer than this is
# force-marked FAILED by a background sweep — a safety net against a
# hung external call (OCR/Gemini/SMTP) leaving a job "processing" forever.
JOB_STALE_TIMEOUT_MINUTES=30
