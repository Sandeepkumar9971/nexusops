PORT=8000

# Free options: a local MongoDB (`brew install mongodb-community`, then
# mongodb://localhost:27017/ai-hub) or a free MongoDB Atlas M0 cluster
# (the connection-string shape below). Either works with every module.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ai-hub?retryWrites=true&w=majority

# Optional. Parcel Image Intelligence works fully without this — Tesseract
# OCR (local, free, no key) is the primary extraction path; this only
# enables the Gemini vision fallback for overlays OCR can't read. Get a
# free key at https://aistudio.google.com/apikey (free tier; expect a low
# daily request quota, as low as ~20 requests/day on some models).
GEMINI_API_KEY=<your-gemini-api-key>

# Optional override. Defaults to Google's "-latest" alias, which routes to
# whichever current free-tier model has serving capacity — a pinned dated
# model (e.g. gemini-3.1-flash-lite) was observed returning persistent 503
# "high demand" errors. Only set this if you want to pin a specific model.
GEMINI_MODEL=gemini-flash-lite-latest
