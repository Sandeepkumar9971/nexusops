PORT=8000

# Free options: a local MongoDB (`brew install mongodb-community`, then
# mongodb://localhost:27017/ai-hub) or a free MongoDB Atlas M0 cluster
# (the connection-string shape below). Either works with every module.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ai-hub?retryWrites=true&w=majority

# Optional. Parcel Image Intelligence works fully without this — Tesseract
# OCR (local, free, no key) is the primary extraction path; this only
# enables the Gemini vision fallback for overlays OCR can't read. Get a
# free key at https://aistudio.google.com/apikey (free tier; expect a low
# daily request quota, as low as ~20 requests/day on some models).
GEMINI_API_KEY=<your-gemini-api-key>

# Optional override. Defaults to Google's "-latest" alias, which routes to
# whichever current free-tier model has serving capacity — a pinned dated
# model (e.g. gemini-3.1-flash-lite) was observed returning persistent 503
# "high demand" errors. Only set this if you want to pin a specific model.
GEMINI_MODEL=gemini-flash-lite-latest

# The one direction Python calls Node instead of the usual reverse: a
# notification after a job finishes. Shares INTERNAL_API_TOKEN with
# Node's requireInternalToken middleware — generate once, copy to both
# .env files. Without it, notifications are silently skipped (not an
# error) rather than every job failing because Node is unreachable.
NODE_API_BASE_URL=http://127.0.0.1:4000/api
INTERNAL_API_TOKEN=<a long random string, same value as node-api's INTERNAL_API_TOKEN>

# ---- FC Financial Monitor: optional alert/digest delivery channels ----
# None of these are required — the module works fully with only the
# in-app channel active, and an FC's manager (configured via the Target
# Configuration screen's "FC Manager Contacts" table) overrides the
# per-channel recipient below when set.

# Slack: a free incoming webhook (Slack App → Incoming Webhooks).
FINANCIAL_ALERT_SLACK_WEBHOOK_URL=<your-slack-incoming-webhook-url>

# Email: any SMTP account you already have access to (e.g. Gmail with an
# app password, or a free provider like Mailtrap for testing). Set
# FINANCIAL_ALERT_SMTP_HOST=console for a LOCAL TEST MODE that writes the
# email to the application log instead of attempting real SMTP — useful
# for verifying recipient routing without a real mailbox.
FINANCIAL_ALERT_SMTP_HOST=<smtp.example.com, or "console" for local test mode>
FINANCIAL_ALERT_SMTP_PORT=587
FINANCIAL_ALERT_SMTP_USER=<smtp-username>
FINANCIAL_ALERT_SMTP_PASSWORD=<smtp-password>
FINANCIAL_ALERT_EMAIL_FROM=nexusops@example.com
FINANCIAL_ALERT_EMAIL_TO=<default-recipient@example.com>

# WhatsApp: the official Meta WhatsApp Business Cloud API (free tier via
# a Meta developer app — https://developers.facebook.com/docs/whatsapp/cloud-api/get-started).
# Needs an approved message template with one body text parameter.
WHATSAPP_ACCESS_TOKEN=<your-whatsapp-cloud-api-access-token>
WHATSAPP_PHONE_NUMBER_ID=<your-whatsapp-sender-phone-number-id>
WHATSAPP_TEMPLATE_NAME=nexusops_fc_alert
WHATSAPP_TEMPLATE_LANG=en_US
FINANCIAL_ALERT_WHATSAPP_TO=<default-recipient-whatsapp-number-e164-no-plus>
